# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (simple gate on top of Supabase Auth — see README)
ADMIN_EMAILS=you@example.com

# Store defaults (can also be edited later from /admin/settings, stored in DB)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: automatic order-confirmation notifications ---
# Leave any of these empty to disable that channel; nothing else breaks.

# Email via Resend (https://resend.com) — free tier available
RESEND_API_KEY=
RESEND_FROM_EMAIL="DZ Store <orders@yourdomain.com>"

# WhatsApp via Twilio (https://twilio.com/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

